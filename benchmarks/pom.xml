<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.replicos</groupId>
        <artifactId>replicos-parent</artifactId>
        <version>0.9.0-SNAPSHOT</version>
    </parent>
    <artifactId>replicos-benchmarks</artifactId>

    <name>Replicos Benchmarks</name>
    <description>
        JMH benchmarks of replication between two nodes in one JVM: the write latency each replication mode adds,
        where a pair saturates, and what encryption costs per frame. Not published.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.replicos.benchmarks</automatic.module.name>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <bouncycastle-lts.version>2.73.13</bouncycastle-lts.version>
        <corretto-crypto-provider.version>2.5.0</corretto-crypto-provider.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.replicos</groupId>
            <artifactId>replicos</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.betty</groupId>
            <artifactId>betty-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>${hdrhistogram.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-crypto-providers</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <!-- Not dependencies: both Bouncy Castle jars hold the same classes, so
                                 CipherParams.CryptoProvider loads each in a class loader of its own. -->
                            <outputDirectory>${project.build.directory}/providers</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcprov-jdk18on</artifactId>
                                    <version>${bouncycastle.version}</version>
                                    <destFileName>bcprov.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcprov-lts8on</artifactId>
                                    <version>${bouncycastle-lts.version}</version>
                                    <destFileName>bcprov-lts.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.cryptools</groupId>
                                    <artifactId>AmazonCorrettoCryptoProvider</artifactId>
                                    <version>${corretto-crypto-provider.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <destFileName>corretto-crypto-provider.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
